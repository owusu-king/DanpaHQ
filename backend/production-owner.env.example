# Copy to ignored .env.production.owner at repository root; fill every blank.
# Fill once and save as GitHub production environment secret PRODUCTION_OWNER_ENV.
# Owner-only release environment: NEVER attach it to a Render runtime service.
DJANGO_SETTINGS_MODULE=config.settings.production
ENVIRONMENT=production
ALLOWED_HOSTS=api.danpahq.com
CORS_ALLOWED_ORIGINS=https://danpahq.com
CSRF_TRUSTED_ORIGINS=https://api.danpahq.com,https://danpahq.com
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_SSLMODE=require
DATABASE_RUNTIME_ROLE=grp_app
# Initial creation / explicit rotation: must match runtime POSTGRES_PASSWORD.
DATABASE_RUNTIME_PASSWORD=
# Copy EXISTING Render secrets. Never rotate keys merely to run migrations.
DJANGO_SECRET_KEY=
OTP_PEPPER=
ACCESS_TOKEN_KEY=
NATIONAL_ID_PEPPER=
UNIT_ACCESS_CODE_PEPPER=
PASSPORT_SHARE_PEPPER=
MANAGEMENT_CSRF_KEY=
RUNTIME_CONFIG_ENCRYPTION_KEY=
STORAGE_SIGNING_KEY=
REDIS_URL=
S3_ENDPOINT_URL=
S3_BUCKET=danpahq-media
S3_REGION=auto
S3_UPLOAD_METHOD=put
S3_ACCESS_KEY=
S3_SECRET_KEY=
FILE_SCAN_MODE=cloudmersive
CLOUDMERSIVE_API_KEY=
EMAIL_BACKEND=apps.identity.email_backend.ManagementEmailBackend
# Optional legacy fallback; configure the selected provider in Management.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Danpa HQ <no-reply@danpahq.com>
# Optional: create the FIRST superuser only. Remove after successful bootstrap.
# If ANY superuser exists (including disabled), these are ignored.
DJANGO_SUPERUSER_PHONE=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
