# Keep the build context small, and keep host-built artefacts out of the image.
# A Windows .venv copied into a Linux container is broken and enormous.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
media/
staticfiles/

# Git ignores do not protect the Docker build context.
# Runtime/release credentials are injected, never copied into the image.
.env
.env.*
**/.env
**/.env.*
production-owner.env.example
**/*.secret
**/*.secret.*
**/credentials.json
**/*-firebase-adminsdk-*.json
**/*service-account*.json
**/*service_account*.json
**/serviceAccount*.json
**/.credentials
**/.secrets
**/google-services.json
**/GoogleService-Info.plist
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.p8
**/*.jks
**/*.keystore
**/*.mobileprovision
**/id_rsa
**/id_ecdsa
**/id_ed25519

# Local metadata, database exports and recovery artefacts.
.git
**/.git
tmp/
temp/
.tmp/
backups/
recovery/
**/*.dump
**/*.dump.gz
**/*.dump.zip
**/*.backup
**/*.backup.gz
**/*.sql.gz
**/*.sql.bz2
**/*.sql.xz
**/*.sql.zip
/database.sql
/backup*.sql
/dump*.sql
/backup*.zip
/backup*.tar*
/backup*.tgz
/recovery*.zip
/recovery*.tar*
/recovery*.tgz
