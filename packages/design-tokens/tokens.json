        "weight": "400",
        "tracking": "0"
      },
      "label": {
        "size": "12px",
        "lineHeight": "16px",
        "weight": "600",
        "tracking": "0.06em"
      },
      "amount-lg": {
        "size": "32px",
        "lineHeight": "36px",
        "weight": "500",
        "tracking": "-0.01em"
      },
      "amount": {
        "size": "16px",
        "lineHeight": "22px",
        "weight": "500",
        "tracking": "0"
      }
    }
  },
  "space": {
    "base": "4px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "stamp": "2px",
    "pill": "999px",
    "$note": "Nothing above 12px. Heavy rounding is the single loudest tell of a template interface, and it makes dense list rows read as toys rather than records."
  },
  "border": {
    "hairline": "1px",
    "emphasis": "2px",
    "stamp": "3px"
  },
  "elevation": {
    "flat": {
      "value": "none",
      "use": "Default. Separation comes from borders."
    },
    "sheet": {
      "value": "0 -1px 0 0 #DFDCD1, 0 -8px 24px -12px rgba(16,26,23,0.18)",
      "use": "Bottom sheets only."
    },
    "modal": {
      "value": "0 12px 32px -8px rgba(16,26,23,0.24)",
      "use": "Dialogs only."
    }
  },
  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "140ms",
      "base": "220ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "exit": "cubic-bezier(0.3, 0, 0.8, 0.15)"
    },
    "$note": "Every duration halves under prefers-reduced-motion; transforms and opacity only, so a 2019 Android device is not compositing layout."
  },
  "target": {
    "min": "48px",
    "$note": "Android minimum. Enforced in review, not just documented."
  },
  "breakpoint": {
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  }
}