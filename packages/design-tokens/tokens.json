        "use": "Primary text, and the primary action surface."
      },
      "800": {
        "value": "#33291F",
        "use": "Raised dark surface, hover on primary action."
      },
      "700": {
        "value": "#4A3D33",
        "use": "Secondary text on light surfaces."
      },
      "500": {
        "value": "#7A6B5E",
        "use": "Muted text, captions, placeholder."
      },
      "300": {
        "value": "#A89A8C",
        "use": "Disabled text, icon rest state."
      }
    },
    "field": {
