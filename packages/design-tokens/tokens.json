  "elevation": {
    "flat": {
      "value": "none",
      "use": "Default. Separation still comes from borders first."
    },
    "raised": {
      "value": "0 1px 2px rgba(33,26,21,0.06), 0 1px 1px rgba(33,26,21,0.04)",
      "use": "Resting card that needs to sit off the page."
    },
    "lifted": {
      "value": "0 4px 12px -2px rgba(33,26,21,0.10), 0 2px 4px -2px rgba(33,26,21,0.06)",
      "use": "Hover on an interactive card."
    },
    "floating": {
      "value": "0 12px 28px -6px rgba(33,26,21,0.16), 0 4px 10px -4px rgba(33,26,21,0.08)",
      "use": "Menus, popovers, sticky action bars."
    },
    "sheet": {
      "value": "0 -1px 0 0 #E6E0D7, 0 -8px 32px -12px rgba(33,26,21,0.22)",
      "use": "Bottom sheets."
    },
    "modal": {
      "value": "0 24px 56px -12px rgba(33,26,21,0.28)",
      "use": "Dialogs."
    }
  },
  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "140ms",
      "base": "220ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "exit": "cubic-bezier(0.3, 0, 0.8, 0.15)",
      "spring": "cubic-bezier(0.34, 1.4, 0.64, 1)"
    },
    "$note": "Every duration halves under prefers-reduced-motion; transforms and opacity only. Spring is for press feedback and nothing else."
  },
  "target": {
    "min": "48px",
    "$note": "Android minimum. Enforced in review, not just documented."
  },
  "breakpoint": {
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
