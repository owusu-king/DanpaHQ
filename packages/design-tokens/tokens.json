{
  "$meta": {
    "name": "Daylight & Ledger",
    "version": "0.1.0",
    "concept": "Two references from the subject's own world. Adinkra cloth: dark dye stamped on a strict grid, so the ink is a near-black with a green cast and structure comes from registration marks rather than decoration. The mobile-money SMS receipt: the most trusted commercial artefact in Ghana, monospaced and keepable, which is why every amount in this product is set in tabular mono and framed like something you would screenshot.",
    "constraints": [
      "Readable in direct sun on a 300-nit phone: body contrast targets 7:1, never below 4.5:1.",
      "Hairline borders instead of drop shadows. Soft shadows smear on the cheap LCD panels this product runs on, and cost a repaint on scroll.",
      "Touch targets 48dp, Android's minimum, not iOS's 44.",
      "Two font files on the critical path. The display face is decorative weight we can afford to load late."
    ]
  },
  "color": {
    "ink": {
      "900": {
        "value": "#101A17",
        "use": "Primary text, headers. Near-black with a green cast, from adinkra dye."
      },
      "700": {
        "value": "#2B3A35",
        "use": "Secondary text on light surfaces."
      },
      "500": {
        "value": "#5C6B66",
        "use": "Muted text, captions, placeholder."
      },
      "300": {
        "value": "#9AA5A1",
        "use": "Disabled text, icon rest state."
      }
    },
    "field": {
      "0": {
        "value": "#FFFFFF",
        "use": "Cards, sheets, inputs."
      },
      "50": {
        "value": "#F7F6F1",
        "use": "App background. Warm paper, not cream."
      },
      "100": {
        "value": "#EFEDE5",
        "use": "Subtle fills, table stripes."
      },
      "200": {
        "value": "#DFDCD1",
        "use": "Hairline borders. The workhorse divider."
      },
      "300": {
        "value": "#C7C3B5",
        "use": "Stronger borders, input outlines."
      }
    },
    "kola": {
      "50": {
        "value": "#E6F0ED",
        "use": "Selected row, quiet brand fill."
      },
      "300": {
        "value": "#4E9484",
        "use": "Brand on dark surfaces, focus ring."
      },
      "600": {
        "value": "#0B5D4E",
        "use": "Primary action, brand, verified state."
      },
      "800": {
        "value": "#084438",
        "use": "Hover on primary, dark brand surface."
      },
      "900": {
        "value": "#062F27",
        "use": "Pressed state, dark brand surface."
      }
    },
    "harmattan": {
      "100": {
        "value": "#FBF0D2",
        "use": "Pending banner fill."
      },
      "600": {
        "value": "#8A6408",
        "use": "Pending / needs-attention text. Dusty gold, used sparingly."
      },
      "500": {
        "value": "#D9A31E",
        "use": "Pending indicator dot and stamp rule."
      }
    },
    "laterite": {
      "100": {
        "value": "#F8E4DF",
        "use": "Error banner fill."
      },
      "600": {
        "value": "#A93B23",
        "use": "Errors and destructive actions. The red earth of the roads."
      }
    },
    "lagoon": {
      "100": {
        "value": "#E1EBF5",
        "use": "Informational fill."
      },
      "600": {
        "value": "#2F5E8C",
        "use": "Informational text and links out."
      }
    }
  },
  "typography": {
    "family": {
      "display": {
        "value": "'Bricolage Grotesque Variable', 'Public Sans', system-ui, sans-serif",
        "use": "Headings 24px and up only. Irregular widths give the product a face without costing legibility where it matters."
      },
      "body": {
        "value": "'Public Sans Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
        "use": "Everything else. Open apertures survive low-DPI screens and bright sun."
      },
      "mono": {
        "value": "'IBM Plex Mono', ui-monospace, 'Roboto Mono', monospace",
        "use": "Money, reference codes, digital addresses, dates on receipts. Tabular figures, receipt lineage."
      }
    },
    "scale": {
      "display-1": {
        "size": "40px",
        "lineHeight": "44px",
        "weight": "600",
        "tracking": "-0.02em"
      },
      "display-2": {
        "size": "32px",
        "lineHeight": "36px",
        "weight": "600",
        "tracking": "-0.02em"
      },
      "title-1": {
        "size": "24px",
        "lineHeight": "30px",
        "weight": "600",
        "tracking": "-0.01em"
      },
      "title-2": {
        "size": "20px",
        "lineHeight": "26px",
        "weight": "600",
        "tracking": "-0.01em"
      },
      "body": {
        "size": "16px",
        "lineHeight": "24px",
        "weight": "400",
        "tracking": "0"
      },
      "body-strong": {
        "size": "16px",
        "lineHeight": "24px",
        "weight": "600",
        "tracking": "0"
      },
      "caption": {
        "size": "14px",
