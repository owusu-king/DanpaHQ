# Copy to .env and run `docker compose up`. Never commit .env.
#
# The values below are development defaults and work as they are. The secrets
# are placeholders, not secrets: production values come from the platform's
# secret manager. Generate a real one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Hostnames are the docker-compose service names (db, redis, minio). If you run
# the backend outside Docker, change them to localhost.

ENVIRONMENT=local
APP_VERSION=0.1.0
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-only-not-a-real-secret
ALLOWED_HOSTS=localhost,127.0.0.1,api
LOG_LEVEL=INFO
LOG_FORMAT=console

POSTGRES_DB=grp
POSTGRES_USER=grp
POSTGRES_PASSWORD=grp
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

S3_ENDPOINT_URL=http://minio:9000
# The address browsers and phones use. Presigned URLs are handed to
# clients, and no client can resolve the compose service name.

# R2 Bucket https://361f0c6b8290633f2514234c6fe8bc96.r2.cloudflarestorage.com/danpahq
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=grp-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Authentication secrets. Separate from DJANGO_SECRET_KEY so they rotate
# independently: rotating the OTP pepper invalidates live codes only, while
# rotating SECRET_KEY would also break sessions and signed cookies.
OTP_PEPPER=dev-only-not-a-real-secret
ACCESS_TOKEN_KEY=dev-only-not-a-real-secret
NATIONAL_ID_PEPPER=dev-only-not-a-real-secret
UNIT_ACCESS_CODE_PEPPER=dev-only-not-a-real-secret
UNIT_ACCESS_CODE_TTL_DAYS=30
IDEMPOTENCY_TTL_HOURS=24
MANAGEMENT_CSRF_KEY=dev-only-not-a-real-secret

# Ghana messaging. Arkesel can be selected at runtime from Management.
# console: prints codes to the log (development only).
# memory:  captures them for tests.
# null:    production's fail-closed bootstrap until Arkesel is configured.
SMS_BACKEND=console
SMS_TIMEOUT_SECONDS=10
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
ARKESEL_SANDBOX=false
STOLEN_DEVICE_REPORTING_ENABLED=true
RUNTIME_CONFIG_ENCRYPTION_KEY=
# Empty means digital checkout is unavailable; `memory` is accepted only by the
# test settings module. Paystack can be selected at runtime from Management.
PAYMENT_BACKEND=
PAYMENT_INTENT_TTL_MINUTES=30

# File storage backend.
# s3    - MinIO, the same code path as production (the default).
# local - the filesystem, if you would rather not run the minio service.
STORAGE_BACKEND=s3
LOCAL_STORAGE_BASE_URL=http://localhost:8000/storage
STORAGE_SIGNING_KEY=dev-only-not-a-real-secret
FILE_SCAN_MODE=permissive


PAYMENT_BACKEND=
# Separate test and live credentials are shown in Management. The legacy
# PAYSTACK_SECRET_KEY is still accepted as a matching-mode fallback.
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_TEST_PUBLIC_KEY=
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_ALLOW_LIVE=false
PAYSTACK_CALLBACK_URL=
PAYSTACK_PLATFORM_CHARGE_BPS=
# The floor under a part payment, in pesewas. Exists because the receiving
# Portfolio bears the processor's transaction fee, so unbounded micro-payments
# are a cost transfer onto the person owed the money. Settling the entire
# remaining balance is always allowed however small it is.
PAYMENT_MINIMUM_PART_MINOR=5000
# How long a reconciliation exception may stay open before the worker says so,
# and how long before it says so at `critical`. Bind the `event` values in
# docs/runbook.md to a pager; an alert nobody receives is the same as no alert.
PAYMENT_RECONCILIATION_AGEING_HOURS=4
PAYMENT_RECONCILIATION_BREACH_HOURS=24
# Where a financial exception goes when it leaves the process. Slack, PagerDuty,
# Opsgenie and every log platform accept an incoming webhook. Empty means the
# structured log line is the only alert path — a decision to make deliberately,
# not by omission.
PAYMENT_ALERT_WEBHOOK_URL=
# Who owns these. Named in every alert, because one addressed to nobody is one
# everybody assumes somebody else has.
PAYMENT_ALERT_OWNER=
PAYMENT_ALERT_TIMEOUT_SECONDS=5
# How long an external-call idempotency claim is held before another request may
# take it over. Longer than the provider timeout it exists to survive.
IDEMPOTENCY_IN_FLIGHT_SECONDS=90

# Maps and places (ADR 0034). Every key is optional: without them Explore is a
# list and place suggestions come from Danpa HQ's own localities. Use keys from a
# development Google Cloud project here, never production's.
# google     - Places API (New) through the API; the localities when there is no key
# localities - Danpa HQ's neighbourhoods only, never Google
LOCATION_PROVIDER=google
# Server-only: the API calls Places with it, and no client ever receives it.
# Restrict it to the Places API (New) and to the API's egress IP addresses.
GOOGLE_MAPS_SERVER_API_KEY=
# Where suggestions may come from: ISO 3166-1 alpha-2 codes, comma-separated.
GOOGLE_PLACES_REGION_CODES=gh
GOOGLE_PLACES_LANGUAGE=en
GOOGLE_PLACES_TIMEOUT_SECONDS=4

# --- Client build inputs -----------------------------------------------------
# Inlined into the bundle at build time, not read at runtime. Both clients
# refuse to build/start a release without an https value rather than falling
# back to a development address.
#   web:    NEXT_PUBLIC_API_URL=https://api.danpahq.com/api/v1
#   mobile: EXPO_PUBLIC_API_URL=https://api.danpahq.com/api/v1
#
# The web's map. docker-compose passes both to the web container; recreate it
# after changing them. The key is public once built: restrict it to the Maps
# JavaScript API and to Danpa HQ's web origins (http://localhost:3000/* here).
# An empty map ID uses Google's DEMO_MAP_ID in development. A production build
# without a real one has no map, because its price markers cannot draw without it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
#
# The Android map. mobile/app.config.js reads this when a native build is made
# (`npx expo run:*`, EAS Build), from that build's environment, mobile/.env,
# or the repository-root .env for local builds. Expo Go ignores it.
#   GOOGLE_MAPS_ANDROID_API_KEY   restricted to com.danpahq.app and its SHA-1s
# iOS uses Apple Maps and needs no Google Maps API key.
