# Public build-time API base. Set the same variable in Cloudflare Pages.
NEXT_PUBLIC_API_URL=https://api.danpahq.com/api/v1

# Google Identity Services OAuth 2.0 Web application client ID. Public by
# design, and frozen into the Next.js bundle at build time.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Maps are intentionally disabled for production. Do not add Google Maps
# variables unless a billed Maps project is deliberately enabled later.

# Store listings for the mobile app, shown by "Get the mobile app" on the front
# door. Leave empty until a listing is live; its badge then reads "Coming soon".
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
